<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>KmsCqrsFramework</PackageId>
    <Version>1.0.9</Version>
    <Authors>Tim Hayes, Kevin Mollencopf</Authors>
    <RepositoryUrl>https://github.com/kmdeveloping/kms-cqrs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Company>KmDeveloping</Company>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CqrsFramework</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Destructurama.Attributed" Version="5.2.0" />
    <PackageReference Include="Polly" Version="8.6.6" />
    <PackageReference Include="RateLimiter" Version="2.2.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions" Version="8.1.0" />
    <PackageReference Include="SimpleInjector" Version="5.5.0" />
    <PackageReference Include="SimpleInjector.Integration.AspNetCore.Mvc.Core" Version="5.5.0" />
  </ItemGroup>

</Project>
